    "fall": { "file": "sprites/fall.png", "frames": 2, "frameDuration": 0.12, "loop": true },
    "drag": { "file": "sprites/fall.png", "frames": 2, "frameDuration": 0.12, "loop": true },
    "greet": { "file": "sprites/greet.png", "frames": 4, "frameDuration": 0.2, "loop": true },
